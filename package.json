{
  "name": "tawjihi-learning-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "map": "node scripts/project-map.mjs",
    "dev": "LEARN_BACKEND=cloudflare node dev-server.mjs",
    "check:syntax": "node --experimental-vm-modules scripts/check-syntax.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node tests/browser/browser-smoke.mjs",
    "test:navigation": "node tests/browser/browser-navigation.mjs",
    "test:layout": "node tests/browser/browser-layout-consistency.mjs",
    "test:ui-fixes": "node tests/browser/browser-home-layout.mjs && node tests/browser/browser-question-layout.mjs && node tests/browser/browser-routes.mjs",
    "test:math": "node tests/browser/browser-math.mjs",
    "test:render": "node tests/browser/browser-render-sequence.mjs",
    "test:explanations": "node tests/browser/browser-explanation-formats.mjs",
    "test:question-surfaces": "node tests/browser/browser-question-surfaces.mjs",
    "test:assets": "node tests/browser/browser-assets.mjs",
    "test:splash": "node tests/browser/browser-splash.mjs",
    "audit:manageability": "node scripts/audit-manageability.mjs",
    "build": "node scripts/validate-app.mjs",
    "ci": "npm run release",
    "check": "npm run check:syntax && npm run check:types",
    "verify": "npm run check",
    "check:types": "tsc -p jsconfig.json",
    "test:progress-storage": "node tests/browser/browser-progress.mjs && node tests/browser/browser-progress-sync.mjs",
    "package:preview": "node scripts/package-app.mjs",
    "test:preview": "node tests/browser/browser-preview.mjs",
    "release": "npm run check:syntax -- --all && npm run check:types && npm run test:deployment && npm run package:cloudflare",
    "test:accounts": "BROWSER_ACCOUNTS_ONLY=1 node tests/browser/browser-smoke.mjs",
    "test:progress": "BROWSER_ROADMAP_ONLY=1 node tests/browser/browser-smoke.mjs",
    "test:motion": "BROWSER_MOTION_ONLY=1 node tests/browser/browser-smoke.mjs",
    "test:a11y": "BROWSER_A11Y=1 node tests/browser/browser-smoke.mjs",
    "test:compat": "node tests/browser/browser-compat.mjs",
    "start": "node server.mjs",
    "database:backup": "node scripts/database-maintenance.mjs backup",
    "database:reset": "node scripts/database-maintenance.mjs reset",
    "owner": "node scripts/owner-account.mjs",
    "database:restore-check": "node scripts/database-maintenance.mjs restore-check",
    "database:migrate-check": "node scripts/database-maintenance.mjs migrate-check",
    "test:capacity": "node scripts/measure-capacity.mjs",
    "test:recovery": "node --test tests/database-recovery.test.mjs",
    "measure:browser": "node scripts/measure-browser.mjs",
    "test:webkit": "BROWSER_WEBKIT_ONLY=1 node tests/browser/browser-compat.mjs",
    "package:server": "node scripts/package-app.mjs --server",
    "check:full": "npm run check:syntax -- --all && npm run check:types && npm test && npm run build",
    "verify:full": "node scripts/run-gate.mjs verify",
    "release:full": "node scripts/run-gate.mjs release",
    "test:deployment": "node --test tests/cloudflare-deploy.test.mjs tests/deploy-command.test.mjs",
    "package:cloudflare": "node scripts/package-cloudflare.mjs",
    "preview:cloudflare": "node scripts/preview-cloudflare.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:status": "gh run list --repo MalikAhed/khutwa-app --workflow cloudflare-pages.yml --event workflow_dispatch --limit 3",
    "verify:live": "DEPLOYMENT_URL=https://khutwaa.pages.dev node .github/cloudflare/verify-deployment.mjs",
    "dev:local": "LEARN_BACKEND=local node dev-server.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.11.1",
    "awesome-phonenumber": "7.8.0",
    "dompurify": "3.4.17",
    "marked": "18.0.7"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "axe-core": "^4.13.0",
    "katex": "0.19.0",
    "playwright": "^1.63.0",
    "typescript": "5.9.3"
  }
}
